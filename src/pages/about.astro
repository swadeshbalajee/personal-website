---
import Container from '../components/common/Container.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';

const location = 'Chennai, Tamil Nadu, India';

const bioParagraphs = [
  "I'm an incoming M.S. by Research student in the Department of Data Science and Artificial " +
    'Intelligence at IIT Madras (starting July 2026), and currently a Post-Baccalaureate Fellow ' +
    'at the Centre for Responsible AI (CeRAI), working on problems at the intersection of ' +
    'machine learning, language models, reinforcement learning, and agentic systems.',
  'My research interests center on building more capable and efficient AI systems — ' +
    'particularly LLM reasoning, context and memory management for long-horizon tasks, ' +
    'reinforcement learning for tool-using agents, policy optimization, knowledge distillation, ' +
    'and inverse optimization. I like learning algorithms that are structured, sample-efficient, ' +
    'and useful in realistic settings where models must plan, retrieve, reason, and adapt over ' +
    'multiple steps.',
  'Before moving deeper into research, I worked as a Software Engineer at Samsung, building data ' +
    'engineering systems with Python, Apache Spark, Airflow, BigQuery, and Google Cloud Platform. ' +
    'That experience shaped how I approach research: I care not only about whether an idea is ' +
    'mathematically interesting, but whether it can be implemented, scaled, evaluated, and turned ' +
    'into something useful.',
];

const experience = [
  {
    role: 'Post-Baccalaureate Fellow',
    organization: 'Centre for Responsible AI (CeRAI)',
    period: 'September 2025 – Present',
    summary:
      'Working on problems at the intersection of machine learning, language models, reinforcement learning, and agentic systems.',
  },
  {
    role: 'Software Engineer',
    organization: 'Samsung Electronics',
    period: 'December 2022 – September 2025',
    summary:
      'Built data engineering systems using Python, Apache Spark, Airflow, BigQuery, and Google Cloud Platform.',
  },
  {
    role: 'Associate Software Engineer (previously College Intern)',
    organization: 'Caterpillar Inc.',
    period: 'January 2022 – December 2022',
    summary:
      'Started as a college intern and converted to a full-time associate software engineer role.',
  },
];

const education = [
  {
    credential: 'M.S. by Research, Data Science and Artificial Intelligence',
    institution: 'Indian Institute of Technology, Madras',
    period: 'Starting July 2026',
  },
  {
    credential: 'B.Tech, Computer Science',
    institution: 'College of Engineering, Guindy',
    period: '2018 – 2022',
  },
];

const interests = [
  'Reinforcement Learning',
  'LLM Reasoning',
  'Agentic Systems',
  'Responsible AI',
  'Astronomy & Astrophysics',
];

const certifications = [
  'From the Big Bang to Dark Energy — IIST Astronomy & Astrophysics',
  'Certification in AI/ML',
  'Generative AI with Large Language Models',
  'Natural Language Processing Specialization',
];

const honors = [
  'Provisional discoverer of 4 asteroids',
  "Second place, Hyperion '21",
  'Best Political Party award',
];

const currentStudy = siteConfig.currentlyExploring;
---

<BaseLayout title="About" description={`About ${siteConfig.name}.`} path="/about">
  <section class="section">
    <Container>
      <header class="page-header">
        <h1>About</h1>
        <p class="text-tertiary">{location}</p>
      </header>

      <div class="about-body">
        <section aria-labelledby="bio-heading">
          <h2 id="bio-heading">Biography</h2>
          {bioParagraphs.map((paragraph) => <p>{paragraph}</p>)}
        </section>

        <section aria-labelledby="skills-heading">
          <h2 id="skills-heading">Skills</h2>
          <div class="skills-grid">
            {
              siteConfig.skills.map((group) => (
                <div>
                  <h3 class="skills-grid__category">{group.category}</h3>
                  <ul class="tag-list-plain">
                    {group.items.map((item) => (
                      <li class="badge">{item}</li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </section>

        <section aria-labelledby="interests-heading">
          <h2 id="interests-heading">Interests</h2>
          <ul class="tag-list-plain">
            {interests.map((interest) => <li class="badge">{interest}</li>)}
          </ul>
        </section>

        <section aria-labelledby="experience-heading">
          <h2 id="experience-heading">Experience</h2>
          <ul class="timeline">
            {
              experience.map((item) => (
                <li>
                  <p class="timeline__role">{item.role}</p>
                  <p class="timeline__meta text-tertiary">
                    {item.organization} · {item.period}
                  </p>
                  <p>{item.summary}</p>
                </li>
              ))
            }
          </ul>
        </section>

        <section aria-labelledby="education-heading">
          <h2 id="education-heading">Education</h2>
          <ul class="timeline">
            {
              education.map((item) => (
                <li>
                  <p class="timeline__role">{item.credential}</p>
                  <p class="timeline__meta text-tertiary">
                    {item.institution} · {item.period}
                  </p>
                </li>
              ))
            }
          </ul>
        </section>

        <section aria-labelledby="certifications-heading">
          <h2 id="certifications-heading">Certifications</h2>
          <ul class="stack gap-2">
            {certifications.map((item) => <li>{item}</li>)}
          </ul>
        </section>

        <section aria-labelledby="honors-heading">
          <h2 id="honors-heading">Honors</h2>
          <ul class="stack gap-2">
            {honors.map((item) => <li>{item}</li>)}
          </ul>
        </section>

        <section aria-labelledby="study-heading">
          <h2 id="study-heading">Current areas of study</h2>
          <ul class="stack gap-2">
            {currentStudy.map((item) => <li>{item}</li>)}
          </ul>
        </section>
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  .page-header {
    margin-bottom: var(--space-6);
  }

  .page-header p {
    margin-top: var(--space-2);
  }

  .about-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    max-width: var(--article-width);
  }

  .about-body h2 {
    font-size: var(--font-size-lg);
    margin-bottom: var(--space-3);
  }

  .about-body p + p {
    margin-top: var(--space-3);
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-5);
  }

  .skills-grid__category {
    font-size: var(--font-size-sm);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-tertiary);
    margin-bottom: var(--space-2);
  }

  .tag-list-plain {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
  }

  .timeline {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .timeline__role {
    font-weight: 650;
  }

  .timeline__meta {
    font-size: var(--font-size-sm);
    margin-top: 0.15em;
  }
</style>
