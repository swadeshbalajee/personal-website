---
import Container from '../components/common/Container.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';

// Placeholder structure — replace with real publications, or remove the
// example entry entirely and leave the array empty until there's something
// to list. Nothing here should be treated as an actual publication.
interface Publication {
  title: string;
  authors: string;
  venue: string;
  year: number;
  url?: string;
}

const publications: Publication[] = [
  {
    title: 'Example paper title — replace with a real publication',
    authors: `${siteConfig.name}, et al.`,
    venue: 'Venue / conference / journal name',
    year: 2026,
  },
];
---

<BaseLayout
  title="Publications"
  description={`Publications by ${siteConfig.name}.`}
  path="/publications"
>
  <section class="section">
    <Container>
      <header class="page-header">
        <h1>Publications</h1>
        <p class="text-secondary">Research papers and other publications.</p>
      </header>

      {
        publications.length === 0 ? (
          <p class="empty-state">No publications listed yet.</p>
        ) : (
          <ul class="publication-list">
            {publications.map((pub) => (
              <li class="card publication-card">
                <p class="publication-card__title">
                  {pub.url ? (
                    <a href={pub.url} target="_blank" rel="noopener noreferrer">
                      {pub.title}
                      <span class="visually-hidden">(opens in a new tab)</span>
                    </a>
                  ) : (
                    pub.title
                  )}
                </p>
                <p class="publication-card__meta text-secondary">{pub.authors}</p>
                <p class="publication-card__meta text-tertiary">
                  {pub.venue} · {pub.year}
                </p>
              </li>
            ))}
          </ul>
        )
      }

      <p class="text-tertiary placeholder-note">
        This is placeholder structure — edit the <code>publications</code> array in src/pages/publications.astro
        with real entries (or clear it to show the empty state) once there's something to list.
      </p>
    </Container>
  </section>
</BaseLayout>

<style>
  .page-header {
    margin-bottom: var(--space-6);
    max-width: 65ch;
  }

  .page-header p {
    margin-top: var(--space-3);
  }

  .publication-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: var(--article-width);
  }

  .publication-card {
    gap: var(--space-2);
  }

  .publication-card__title {
    font-weight: 650;
    font-size: var(--font-size-md);
  }

  .publication-card__title a {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--color-border-strong);
  }

  .publication-card__title a:hover {
    color: var(--color-accent);
  }

  .publication-card__meta {
    font-size: var(--font-size-sm);
  }

  .placeholder-note {
    margin-top: var(--space-6);
    max-width: var(--article-width);
    font-size: var(--font-size-sm);
  }
</style>
