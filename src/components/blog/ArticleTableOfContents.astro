---
export interface TocHeading {
  depth: number;
  slug: string;
  text: string;
}

interface TocNode {
  slug: string;
  text: string;
  children: TocNode[];
}

interface Props {
  headings: TocHeading[];
}

const { headings } = Astro.props;

function buildToc(items: TocHeading[]): TocNode[] {
  const roots: TocNode[] = [];
  let currentH2: TocNode | null = null;

  for (const heading of items) {
    if (heading.depth === 2) {
      const node: TocNode = { slug: heading.slug, text: heading.text, children: [] };
      roots.push(node);
      currentH2 = node;
    } else if (heading.depth === 3) {
      const node: TocNode = { slug: heading.slug, text: heading.text, children: [] };
      if (currentH2) {
        currentH2.children.push(node);
      } else {
        roots.push(node);
      }
    }
  }

  return roots;
}

const toc = buildToc(headings.filter((h) => h.depth === 2 || h.depth === 3));
---

{
  toc.length > 0 && (
    // A native <details> element makes the table of contents collapsible on
    // mobile and fully keyboard/screen-reader accessible with zero
    // JavaScript; the script below only layers on active-section highlighting.
    <details class="toc" data-toc open>
      <summary class="toc__title">On this page</summary>
      <ul class="toc__list">
        {toc.map((node) => (
          <li>
            <a href={`#${node.slug}`} data-toc-link data-toc-target={node.slug}>
              {node.text}
            </a>
            {node.children.length > 0 && (
              <ul>
                {node.children.map((child) => (
                  <li>
                    <a href={`#${child.slug}`} data-toc-link data-toc-target={child.slug}>
                      {child.text}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </details>
  )
}

<style>
  .toc summary {
    cursor: pointer;
    list-style: none;
  }

  .toc summary::-webkit-details-marker {
    display: none;
  }

  .toc summary::before {
    content: '';
  }
</style>

<script>
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');
  if (links.length > 0) {
    const targets = Array.from(links)
      .map((link) => {
        const slug = link.dataset.tocTarget;
        const heading = slug ? document.getElementById(slug) : null;
        return heading ? { link, heading } : null;
      })
      .filter(
        (entry): entry is { link: HTMLAnchorElement; heading: HTMLElement } => entry !== null,
      );

    if (targets.length > 0 && 'IntersectionObserver' in window) {
      const setActive = (slug: string | null) => {
        for (const { link } of targets) {
          const isActive = link.dataset.tocTarget === slug;
          link.toggleAttribute('aria-current', isActive);
          if (isActive) link.setAttribute('aria-current', 'true');
        }
      };

      const visible = new Set<string>();
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            const slug = (entry.target as HTMLElement).id;
            if (entry.isIntersecting) {
              visible.add(slug);
            } else {
              visible.delete(slug);
            }
          }
          const firstVisible = targets.find(({ heading }) => visible.has(heading.id));
          if (firstVisible) setActive(firstVisible.heading.id);
        },
        { rootMargin: '-96px 0px -70% 0px', threshold: 0 },
      );

      for (const { heading } of targets) observer.observe(heading);
    }
  }
</script>
