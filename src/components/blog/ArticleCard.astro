---
import { Image } from 'astro:assets';
import TagList from './TagList.astro';
import { formatDateLong } from '../../lib/dates';

interface Props {
  href: string;
  title: string;
  description: string;
  publishedAt: Date;
  readingTimeText: string;
  tags: string[];
  featured?: boolean;
  draft?: boolean;
  cover?: ImageMetadata;
  coverAlt?: string;
}

const {
  href,
  title,
  description,
  publishedAt,
  readingTimeText,
  tags,
  featured = false,
  draft = false,
  cover,
  coverAlt,
} = Astro.props;
---

<article class:list={['card', 'article-card', { 'article-card--featured': featured }]}>
  {
    cover && (
      <div class="article-card__cover">
        <Image src={cover} alt={coverAlt ?? ''} width={640} height={360} />
      </div>
    )
  }
  <div class="article-card__badges">
    {featured && <span class="badge badge--accent">Featured</span>}
    {draft && <span class="badge draft-badge">Draft</span>}
  </div>
  <h3 class="article-card__title">
    <a href={href}>{title}</a>
  </h3>
  <p class="text-secondary">{description}</p>
  <div class="article-card__meta">
    <time datetime={publishedAt.toISOString()}>{formatDateLong(publishedAt)}</time>
    <span class="meta-dot">{readingTimeText}</span>
  </div>
  <div class="article-card__tags">
    <TagList tags={tags} />
  </div>
</article>

<style>
  .article-card {
    padding: 0;
    overflow: hidden;
  }

  .article-card__cover {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
  }

  .article-card__cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article-card__badges:not(:empty) {
    display: flex;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-4) 0;
  }

  .article-card__title,
  .article-card > p,
  .article-card > .article-card__meta,
  .article-card > .article-card__tags {
    margin-inline: var(--space-4);
  }

  .article-card__title {
    margin-top: var(--space-4);
    font-size: var(--font-size-md);
  }

  .article-card__title a {
    color: var(--color-text);
    text-decoration: none;
  }

  .article-card__title a:hover {
    color: var(--color-accent);
  }

  .article-card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .article-card {
    position: relative;
  }

  .article-card__meta {
    font-size: var(--font-size-sm);
    color: var(--color-text-tertiary);
  }

  .article-card > p {
    font-size: var(--font-size-sm);
  }

  .article-card > .article-card__tags {
    margin-bottom: var(--space-4);
    position: relative;
    z-index: 1;
  }

  .article-card--featured {
    border-color: var(--color-accent);
  }
</style>
