---
import ImageFigure from '../blog/ImageFigure.astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  width?: number;
  height?: number;
}

const { src, alt, caption, width, height } = Astro.props;
---

<ImageFigure src={src} alt={alt} caption={caption} width={width} height={height} />
