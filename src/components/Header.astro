---
import Container from './common/Container.astro';
import Icon from './common/Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import { siteConfig } from '../config/site';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

function isActive(href: string): boolean {
  const normalized = href.replace(/\/$/, '') || '/';
  if (normalized === '/') return currentPath === '/';
  return currentPath === normalized || currentPath.startsWith(`${normalized}/`);
}
---

<header class="site-header">
  <Container>
    <div class="site-header__inner">
      <a class="site-header__brand" href="/">{siteConfig.name}</a>

      <nav class="site-nav site-nav--desktop" aria-label="Primary">
        <ul class="site-nav__list">
          {
            siteConfig.nav.map((link) => (
              <li>
                <a
                  class="site-nav__link"
                  href={link.href}
                  aria-current={isActive(link.href) ? 'page' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="site-header__actions">
        <a
          href="/search"
          class="button button--icon button--secondary"
          aria-label="Search (or press /)"
          data-search-trigger
        >
          <Icon name="search" />
        </a>
        <ThemeToggle />
        <button
          type="button"
          class="button button--icon button--secondary mobile-nav-trigger"
          data-mobile-nav-trigger
          aria-expanded="false"
          aria-controls="mobile-navigation"
        >
          <Icon name="menu" />
          <span class="visually-hidden">Open navigation menu</span>
        </button>
      </div>
    </div>
  </Container>
</header>
